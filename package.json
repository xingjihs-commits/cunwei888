{
  "name": "village-bridge",
  "version": "1.7.0",
  "description": "村务连心桥 - 村级掌上连心桥微信小程序",
  "main": "main.js",
  "scripts": {
    "dev:mp-weixin": "node scripts/uni-cli.js -p mp-weixin",
    "build:mp-weixin": "node scripts/uni-cli.js build -p mp-weixin",
    "dev:h5": "node scripts/uni-cli.js",
    "build:h5": "node scripts/uni-cli.js build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .js,.vue",
    "format": "prettier --write \"{pages,components,utils,store,composables}/**/*.{js,vue}\"",
    "gen:doc": "node scripts/gen-structure.js",
    "check:doc": "node scripts/check-structure.js",
    "check:tokens": "node scripts/compare-tokens.js",
    "map:check": "node scripts/check-project-map.js",
    "style:check": "node scripts/check-style.js",
    "sync:common": "node scripts/sync-common.js"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/uni-app-plus": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/uni-components": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/uni-h5": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-3081220230817001",
    "pinia": "^2.1.6",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@dcloudio/uni-automator": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/uni-cli-shared": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/uni-stacktracey": "^3.0.0-alpha-3081220230817001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-alpha-3081220230817001",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.9",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "vite": "^5.2.0",
    "vitest": "^1.0.0"
  }
}
